# Backend origin (no path suffix) — used server-side only by the
# next.config.ts rewrite, which proxies /api/proxy/* to `${BACKEND_ORIGIN}/api/v1/*`.
# The browser never calls this URL directly: it only ever talks to this app's
# own origin, so auth cookies stay first-party instead of being blocked as
# third-party by Safari/Firefox/Brave/in-app browsers.
# For development: http://localhost:5000
# For production: https://your-backend.onrender.com
BACKEND_ORIGIN=http://localhost:5000

# Canonicals are fixed to https://www.sharda.social in lib/seo/site.ts to match
# the existing hosting redirect. No NEXT_PUBLIC_SITE_URL override is needed.
# VERCEL_ENV=preview (provided by Vercel) adds noindex response headers.
